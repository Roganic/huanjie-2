# 后端环境变量配置示例
# 复制为 .env 并填入实际值

# 服务端口 (Railway/Render 会自动注入 PORT)
PORT=8000

# CORS 允许的来源
# 本地开发: 使用默认值或 http://localhost:5173
# 生产环境: 设置为 GitHub Pages 域名，如 https://username.github.io
# 多个来源用逗号分隔: CORS_ALLOW_ORIGINS=https://a.com,https://b.com
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============================================
# AI 叙事模型配置 (至少配置一个)
# ============================================

# Kimi (Moonshot) 配置
KIMI_API_KEY=                    # 必填: 从 https://platform.moonshot.cn 获取
KIMI_API_URL=https://api.moonshot.cn/v1/chat/completions
KIMI_MODEL=moonshot-v1-8k
KIMI_TIMEOUT_SECONDS=5

# OpenAI 配置
OPENAI_API_KEY=                  # 可选: 如需使用 OpenAI 模型
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=5
