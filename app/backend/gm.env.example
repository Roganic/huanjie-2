# Copy to app/backend/.env.gm. This local file is ignored by Git.
# Use the key for the SAME region as GM_API_URL. Never use a frontend VITE_* variable.
GM_ENABLED=true
GM_API_STYLE=qwen
GM_API_URL=
# Copy the complete Chat Completions URL from your provider's workspace console.
# Beijing example: https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1/chat/completions
GM_MODEL=qwen3.7-flash-2026-07-15
GM_AUTHORING_MODEL=
# Optional model on the same endpoint for module authoring only.
GM_API_KEY=
GM_BUDGET_YUAN=2
# Initial model screening ceiling. Local total may be raised up to 20 yuan;
# hosted usage has its own 25-yuan allocation. Never delete the usage ledger.
# Changing this file takes effect on the next request; no game restart is required.
# Set GM_ENABLED=false to use fixed narration and the original deterministic controls.
# GM_API_STYLE: standard | qwen | deepseek | kimi | glm
# Free BigModel: style=glm, model=glm-4.7-flash
# URL: https://open.bigmodel.cn/api/paas/v4/chat/completions
# Only models supporting Chat Completions Function Calling are compatible.
