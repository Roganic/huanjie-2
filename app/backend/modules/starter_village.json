      "name": "开始战斗",
      "description": "进入与地精的战斗模式",
      "conditions": [],
      "actions": [
        {
          "type": "enter_combat",
          "target_id": "goblin_raider",
          "parameters": {}
        }
      ],
      "once_only": true,
      "enabled": true
    },
    {
      "id": "complete_objective_defeat",
      "name": "完成击败目标",
      "description": "标记击败地精目标为完成",
      "conditions": [],
