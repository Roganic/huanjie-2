          "target_id": "rusty_dagger",
          "parameters": {"quantity": 1}
        }
      ],
      "once_only": true,
      "enabled": true
    },
    {
      "id": "complete_quest",
      "name": "完成任务",
      "description": "标记地精任务为完成状态",
      "conditions": [],
      "actions": [
        {
          "type": "set_quest_status",
          "target_id": "goblin_menace",
