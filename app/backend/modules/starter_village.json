        {
          "type": "complete_objective",
          "target_id": "defeat_goblin",
          "parameters": {}
        }
      ],
      "once_only": true,
      "enabled": true
    },
    {
      "id": "give_loot",
      "name": "给予战利品",
      "description": "给予玩家击败地精的战利品",
      "conditions": [],
