  "characters": {
    "lu": {
      "id": "lu",
      "name": "陆衡",
      "type": "friendly",
      "description": "疲惫的巡水官，手背留着铜锈。",
      "dialogue": "请去旧档案馆核实铜材账册，再到市集找闻笙。低城的水已经涨进人家。",
      "personality": "愿意承担眼前救援，却害怕自己的签字被公开。不要在账册未核实前承认具体数字。",
      "clue": "宋芷保存着账册，季安知道潮心的构造。"
    },
    "song": {
      "id": "song",
      "name": "宋芷",
      "type": "friendly",
      "description": "档案管理员，指尖沾满纸灰。",
      "dialogue": "真正的账页夹在童谣集里。我可以解释旧编号，但需要你亲自核实。最后把潮心处置结果带回来，我会记录它。",
      "personality": "相信完整记录比完美英雄更可靠。"
    },
    "ji": {
      "id": "ji",
      "name": "季安",
      "type": "friendly",
      "description": "老玻璃匠，左耳听力不好。",
      "dialogue": "潮心的旧图就在墙上。你若先说明怎样保护低城，我愿意帮你读；否则你可以慢慢抄。",
      "personality": "不信空话，愿意支持具体可执行的救援方案。"
    },
    "wen": {
      "id": "wen",
      "name": "闻笙",
      "type": "friendly",
      "description": "医师，衣袖被盐水浸出白边。",
      "dialogue": "请修好蓄水池滤层。追责可以等，病人不能等。",
      "personality": "先救人，拒绝没有替代供水就毁掉机器。"
    },
    "du": {
      "id": "du",
      "name": "杜婆",
      "type": "friendly",
      "description": "退休机师，腰间挂着一把不再合锁的旧钥匙。",
      "dialogue": "机器一直听旧命令。你得同时看账册和管线图，才能知道该从哪边泄压。卡住时先卸力，再按顺序重置。",
      "personality": "理解机器却后悔当年没有反对不公平的水路。"
    },
