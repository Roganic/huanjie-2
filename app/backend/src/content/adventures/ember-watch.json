  "characters": {
    "ember-captain": {
      "id": "ember-captain",
      "name": "守备队长伊莲",
      "type": "friendly",
      "description": "一位疲惫的守备队长，把旧巡逻名册压在手下。",
      "dialogue": "巡逻队失联了。你可以核实他们为何改道，也可以清理截断归路的匪徒。先从我的证言、档案室或河岸查起。",
      "clue": "失踪巡逻队留下的是改道信号；旧档案室的钟声记录和河岸船夫可以交叉核实。",
      "personality": "谨慎、直接，不愿凭空认定巡逻队遇害。面对抱怨先倾听，只有明确请求才考虑是否合作。",
      "knowledge": [
        {
          "id": "public",
          "text": "旧档案室在广场东边，河岸在南边；河岸能通往匪徒营地。"
        },
        {
          "id": "private",
          "text": "巡逻队曾用两短一长的钟声表示改道；没有证据表明他们已经死亡。",
          "required_flags": [
            "ember-testimony"
          ]
        }
      ]
    },
    "ember-witness": {
      "id": "ember-witness",
      "name": "抄写员诺娅",
      "type": "neutral",
      "description": "年轻的抄写员守着被烟熏黑的档案柜。",
      "dialogue": "昨夜有人烧了部分巡逻记录。你可以检查残页；若原件坏了，我还知道副本在哪。",
      "personality": "胆小但认真，不知道匪徒的计划。",
      "knowledge": [
        {
          "id": "archive",
          "text": "档案的残页和钟声记录可以解释巡逻队的去向。"
        },
        {
          "id": "backup",
          "text": "登记副本收在低柜里，按页码整理需要时间。",
          "required_flags": [
            "ember-backup"
