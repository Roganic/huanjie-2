{
  "schema_version": 1,
  "id": "ember-watch",
  "version": "2.0.0",
  "name": "余烬钟声",
  "description": "第二阶段样例冒险：用交涉、调查或战斗找回巡逻队的消息。失败也有后续路线，人物记得你的尝试。",
  "starting_scene_id": "ember-square",
  "scenes": {
    "ember-square": {
      "id": "ember-square",
      "name": "暮钟广场",
      "description": "暮色落在熄灭的钟楼上。伊莲等待巡逻队的消息。你可以争取支援、核实证言，或前往档案室和河岸调查。",
      "exits": [
        {
          "direction": "east",
          "target_scene_id": "ember-archive"
        },
        {
          "direction": "south",
          "target_scene_id": "ember-bank"
        }
      ],
      "character_ids": [
        "ember-captain"
      ],
      "challenges": [
        {
          "id": "ember-support",
          "name": "争取出发支援",
          "target_id": "ember-captain",
          "description": "提出具体支援请求。可凭过往经验或清晰计划说服伊莲；支援与询问证言是不同目标。",
          "skill": "persuasion",
          "dc": 12,
          "stakes": "1 格时间；成功得到一份治疗药水，失败伊莲关系 -1。只能尝试一次。",
          "goal_id": "ember-support",
          "retry": "once",
          "retry_flags": [],
          "complete_on_success": true,
          "on_success": [
            {
              "title": "得到支援",
              "narration": "伊莲批准了一份急救支援。",
              "effects": [
                {
                  "kind": "flag",
                  "value": "ember-support"
                },
                {
                  "kind": "item",
                  "target_id": "healing_potion"
                }
              ]
            }
          ],
          "on_failure": [
            {
              "title": "支援被拒",
              "narration": "伊莲拒绝额外支援，但仍愿意讨论巡逻队的线索。",
              "effects": [
                {
                  "kind": "relationship",
                  "target_id": "ember-captain",
                  "amount": -1
                }
              ]
            }
          ],
          "approaches": [
            {
              "id": "plan",
              "name": "说明行动计划",
              "skill": "persuasion",
              "dc": 12,
              "description": "解释打算如何安全调查"
            },
            {
              "id": "experience",
              "name": "引用类似巡逻经验",
              "skill": "history",
              "dc": 12,
              "description": "结合过往巡逻惯例提出准备方案"
            }
          ],
          "consequences": [
            {
              "id": "encouragement",
              "name": "请求鼓舞",
              "stakes": "1 格时间；成功获得激励，失败关系 -1；不会同时得到药水。",
              "on_success": [
                {
                  "title": "临行鼓舞",
                  "narration": "伊莲用老兵的经验鼓舞了你。",
                  "effects": [
                    {
                      "kind": "flag",
                      "value": "ember-support"
                    },
                    {
                      "kind": "condition",
                      "value": "inspired"
                    }
                  ]
                }
              ],
              "on_failure": [
                {
                  "title": "支援被拒",
                  "narration": "伊莲拒绝额外支援，但仍愿意讨论巡逻队的线索。",
                  "effects": [
                    {
                      "kind": "relationship",
                      "target_id": "ember-captain",
                      "amount": -1
                    }
                  ]
                }
              ]
            }
          ],
          "completed_flags": [
            "ember-support"
          ]
        },
        {
          "id": "ember-testimony",
          "name": "核实队长的证言",
          "target_id": "ember-captain",
          "description": "请求伊莲核实最后的钟声。只问公开消息无需检定；要取得可据以报告的完整证言则需要她配合。",
          "skill": "persuasion",
          "dc": 12,
          "stakes": "1 格时间；成功取得改道证言，失败关系 -1，但得到档案室调查方向。",
          "goal_id": "ember-testimony",
          "retry": "once",
          "retry_flags": [],
          "complete_on_success": true,
          "on_success": [
            {
              "title": "证言核实",
              "narration": "伊莲确认：两短一长是改道信号，巡逻队可能在避风港。你已有足够证据提交调查报告。",
              "effects": [
                {
                  "kind": "flag",
                  "value": "ember-report"
                },
                {
                  "kind": "flag",
                  "value": "ember-testimony"
                },
                {
                  "kind": "clue",
                  "target_id": "ember-proof",
                  "value": "伊莲确认最后钟声是改道信号，足以提交报告。"
                }
              ]
            }
          ],
          "on_failure": [
            {
              "title": "证言不足",
              "narration": "伊莲不能确认细节，态度变得冷淡；她建议你去旧档案室核对钟声记录。",
              "effects": [
                {
                  "kind": "relationship",
                  "target_id": "ember-captain",
                  "amount": -1
                },
                {
                  "kind": "flag",
                  "value": "ember-referred"
                },
                {
                  "kind": "clue",
                  "target_id": "ember-next",
                  "value": "旧档案室保存着钟声记录，可以独立调查。"
                }
              ]
            }
          ],
          "approaches": [
            {
              "id": "reassure",
              "name": "耐心说明核实目的",
              "skill": "persuasion",
              "dc": 12,
              "description": "让队长相信你会如实呈报"
            },
            {
              "id": "reconstruct",
              "name": "引导回忆当时细节",
              "skill": "insight",
              "dc": 14,
              "description": "根据停顿和情绪引导队长重新核对记忆"
            }
          ],
          "completed_flags": [
            "ember-report"
          ]
        }
      ],
      "safe_rest": true
    },
    "ember-archive": {
      "id": "ember-archive",
      "name": "旧档案室",
      "description": "焦纸味尚未散去。诺娅守着残页，低柜里是成叠的登记册。",
      "exits": [
        {
          "direction": "west",
          "target_scene_id": "ember-square"
        }
      ],
      "character_ids": [
        "ember-witness"
      ],
      "challenges": [
        {
          "id": "ember-record",
          "name": "辨认烧焦的记录",
          "target_id": "ember-archive",
          "description": "检查残页中的钟声或魔法记号；失败仍可转向副本。",
          "skill": "investigation",
          "dc": 12,
          "stakes": "1 格时间；成功获得报告证据；失败受伤 1 点并找到副本线索，2 格时间后烟尘会再次造成 1 点伤害（先完成报告证据可取消）。",
          "goal_id": "ember-record",
          "retry": "once",
          "retry_flags": [],
          "complete_on_success": true,
          "on_success": [
            {
              "title": "还原记录",
              "narration": "残页证实巡逻队主动改道。已有足够证据返回广场报告。",
              "effects": [
                {
                  "kind": "flag",
                  "value": "ember-report"
                },
                {
                  "kind": "flag",
                  "value": "ember-record"
                },
                {
                  "kind": "clue",
                  "target_id": "ember-proof",
                  "value": "钟声记录确认巡逻队主动改道。"
                }
              ]
            }
          ],
          "on_failure": [
            {
              "title": "残页破损",
              "narration": "烟尘呛得你咳嗽，残页无法辨认；诺娅指出低柜中还有登记副本。",
              "effects": [
                {
                  "kind": "damage",
                  "amount": 1
                },
                {
                  "kind": "flag",
                  "value": "ember-backup"
                },
                {
                  "kind": "clue",
                  "target_id": "ember-backup",
                  "value": "低柜中的登记副本可整理，不需再次辨认残页。"
                }
              ]
            },
            {
              "title": "烟尘扩散",
              "narration": "档案室的烟尘再次灼伤了你。",
              "effects": [
                {
                  "kind": "damage",
                  "amount": 1
                }
              ],
              "category": "environment",
              "priority": "urgent",
              "delay": 2,
              "scene_id": "ember-archive",
              "cancel_flags": [
                "ember-report"
              ],
              "cancel_on_leave": true
            }
          ],
          "approaches": [
            {
              "id": "pages",
              "name": "核对页码与字迹",
              "skill": "investigation",
              "dc": 12,
              "description": "用页码和剩余字迹拼接记录"
            },
            {
              "id": "runes",
              "name": "辨识钟声记号",
              "skill": "arcana",
              "dc": 14,
              "description": "解读残页上的传讯记号"
            }
          ],
          "completed_flags": [
            "ember-report"
          ]
        },
        {
          "id": "ember-copy",
          "name": "整理登记副本",
          "target_id": "ember-archive",
          "description": "沿低柜页码逐页核对，无不确定结果，只付出时间。",
          "goal_id": "ember-copy",
          "check_kind": "automatic",
          "time_cost": 2,
          "stakes": "2 格时间；取得完整证据。若仍留在烟尘中，之前安排的烟尘后果可能先到。",
          "retry": "once",
          "complete_on_success": true,
          "required_flags": [
            "ember-backup"
          ],
          "completed_flags": [
            "ember-report"
          ],
          "on_success": [
            {
              "title": "副本核实",
              "narration": "你付出时间整理副本，确认巡逻队沿支流改道。可以返回广场报告。",
              "effects": [
                {
                  "kind": "flag",
                  "value": "ember-report"
                },
                {
                  "kind": "flag",
                  "value": "ember-recovered"
                },
                {
                  "kind": "clue",
                  "target_id": "ember-proof",
                  "value": "登记副本确认巡逻队沿支流改道。"
                }
              ]
            }
          ]
        }
      ],
      "safe_rest": false
