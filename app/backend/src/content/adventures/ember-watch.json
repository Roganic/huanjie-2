        }
      ]
    },
    "ember-ferryman": {
      "id": "ember-ferryman",
      "name": "船夫洛恩",
      "type": "neutral",
      "description": "一个沉默的船夫坐在潮湿的栈桥边。",
      "dialogue": "我见过巡逻队的船，但你得拿航线说话，或者让我相信你会如实报告。营地就在河岸北边，里面有两名匪徒。",
      "personality": "务实，讨厌夸口。只讲亲眼见过的事。",
      "knowledge": [
        {
          "id": "river",
          "text": "巡逻船沿支流向避风港去了，匪徒仍在营地。",
          "required_flags": [
            "ember-river"
          ]
        }
      ]
    },
