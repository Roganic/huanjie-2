        {
          "id": "ember-river",
          "name": "核实船夫的航线",
          "target_id": "ember-ferryman",
          "description": "用航行痕迹或解释报告目的核实巡逻船去向。",
          "skill": "survival",
          "dc": 12,
          "stakes": "1 格时间；成功取得航线证据，失败关系 -1，并明确可清理营地保障归路。",
          "goal_id": "ember-river",
          "retry": "once",
          "retry_flags": [],
          "complete_on_success": true,
          "on_success": [
            {
              "title": "航线核实",
