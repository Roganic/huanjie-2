  "characters": {
    "cen": {
      "id": "cen",
      "name": "岑婆",
      "type": "friendly",
      "description": "头发银白的守灯人，掌心全是绳茧。",
      "dialogue": "最后一班船还有七个人。去修灯棚问阿禾，或去潮阶找维修匣；实在不行，在灯塔敲三短一长，让船靠避风码头。",
      "personality": "急切但不责备，先救人再查明责任。",
      "clue": "三短一长是避风码头的引航钟声。"
    },
    "he": {
      "id": "he",
      "name": "阿禾",
      "type": "friendly",
      "description": "年轻学徒，袖口沾着镜油，目光总躲开你。",
      "dialogue": "镜框裂了，我只是想修好。我怕岑婆知道……潮阶上还有维修匣。",
      "personality": "羞愧、怕辜负师父；愿意帮助救人。只有成功争取信任才主动提供校准图。"
    }
  },
