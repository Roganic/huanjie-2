  "characters": {
    "cen_po": {
      "id": "cen_po",
      "name": "岑婆",
      "description": "暮潮港的守灯人，皱纹里藏着几十年的潮汐。她把一张潮汐纸摊在你掌心：亮灯，或者敲出正确的钟声。",
      "type": "friendly",
      "race": null,
      "occupation": "守灯人",
      "role": "neutral",
      "alive": true,
      "hp": 8,
      "ac": 10,
      "abilities": {
        "str": 10,
        "dex": 10,
        "con": 10,
        "int": 10,
        "wis": 10,
        "cha": 10
      },
      "weapon_id": null,
      "dialogue": "船上的人不能等我们追究谁的错。亮灯，或者照潮汐纸敲出三短一长的渡钟——雾封港之前，让渡船回家。",
      "clue": null,
      "personality": "沉稳、务实，先救人后问罪；对学徒严格却不肯放弃。",
      "knowledge": [
        {
          "id": "cen_oilman_clear",
          "text": "维修记录证明送油人早早离开时灯还完好，他是清白的。岑婆点头：『那就只剩一个不肯开口的孩子了。』",
          "required_flags": [
            "beat-208ccbb84d3ba6a8506ece2f-success"
          ]
        },
        {
          "id": "cen_aher_bolt",
          "text": "岑婆没有立刻原谅阿禾，却把一颗旧螺栓交给他：『明天开始，你学的第一件事是求助。』",
          "required_flags": [
            "join-2934a0daa778a676974325ba"
          ]
        }
      ],
      "xp_reward": 0,
      "drops": []
    },
    "a_he": {
      "id": "a_he",
      "name": "阿禾",
      "description": "年轻的修灯学徒，手指上有新的擦伤。他发现镜框裂开擅自拆下加固，又怕承认弄断了一颗螺栓，把维修记录藏了起来。",
      "type": "neutral",
      "race": null,
      "occupation": "修灯学徒",
      "role": "neutral",
      "alive": true,
      "hp": 8,
      "ac": 10,
      "abilities": {
        "str": 10,
        "dex": 10,
        "con": 10,
        "int": 10,
        "wis": 10,
        "cha": 10
      },
      "weapon_id": null,
      "dialogue": "我……没什么可说的。灯的事，我自己会处理。",
      "clue": null,
      "personality": "倔强而心虚，相信只要在师父发现前修好就不算犯错；沉默不是恶意。",
      "knowledge": [
        {
          "id": "ahe_confess_chart",
          "text": "阿禾低声承认了镜框和螺栓的事，把藏在袖中的校准图递给你：『照这个调，灯光能扫到小码头。』",
          "required_flags": [
            "beat-fe6bd69c5b80586230801d4c-success"
          ]
        },
        {
          "id": "ahe_after_record",
          "text": "阿禾得知维修记录已被找到，肩膀垮了下来：『我不是想害送油人……我只是怕。』",
          "required_flags": [
            "beat-208ccbb84d3ba6a8506ece2f-success"
