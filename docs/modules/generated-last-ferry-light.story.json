{
  "name": "最后一盏渡灯",
  "description": "暮潮港的最后一班渡船载着七个人入港，浓雾压低而导航灯只剩红色余烬。守灯人岑婆委托你在雾封港前指引渡船回家：修好灯光，或敲出正确的渡钟。真相藏在修灯学徒阿禾的沉默里——调查、交涉与救援，无强制战斗，约20–40分钟，适合1名低等级角色。",
  "starting_scene_id": "ferry_dock",
  "locations": [
    {
      "id": "ferry_dock",
      "name": "渡口",
      "description": "暮潮港的渡口，雾气贴着水面爬行。最后一班渡船的轮廓在雾中若隐若现，守灯人岑婆提着一圈红色余烬的旧灯站在栈桥尽头。",
      "exits": [
        "repair_shed",
        "tide_steps",
        "lighthouse"
      ]
    },
    {
      "id": "repair_shed",
      "name": "修灯棚",
      "description": "堆满灯油桶、螺栓与镜片布的小棚屋。修灯学徒阿禾坐在工作台后，袖口沾着灯灰，眼神躲闪。",
      "exits": [
        "ferry_dock"
      ]
    },
    {
      "id": "tide_steps",
      "name": "潮阶",
      "description": "通往海面的石阶，潮水刚刚漫过第三级。一只铜制维修匣半埋在湿沙里，匣盖浮雕着操作顺序的纹样。",
      "exits": [
        "ferry_dock",
        "lighthouse"
      ]
    },
    {
      "id": "lighthouse",
      "name": "灯塔",
      "description": "暮潮港灯塔的顶层。聚光镜的镜框裂开一道缝，灯芯只剩一圈红色余烬；一旁的渡钟悬在雾里，等着正确的钟声。",
      "exits": [
        "ferry_dock",
        "tide_steps"
      ]
    }
  ],
  "people": [
    {
      "id": "cen_po",
      "name": "岑婆",
      "scene_id": "ferry_dock",
      "type": "friendly",
      "occupation": "守灯人",
      "description": "暮潮港的守灯人，皱纹里藏着几十年的潮汐。她把一张潮汐纸摊在你掌心：亮灯，或者敲出正确的钟声。",
      "dialogue": "船上的人不能等我们追究谁的错。亮灯，或者照潮汐纸敲出三短一长的渡钟——雾封港之前，让渡船回家。",
      "personality": "沉稳、务实，先救人后问罪；对学徒严格却不肯放弃。",
      "knowledge": [
        {
          "id": "cen_oilman_clear",
          "text": "维修记录证明送油人早早离开时灯还完好，他是清白的。岑婆点头：『那就只剩一个不肯开口的孩子了。』",
          "requires": [
            {
              "beat_id": "investigate_box",
              "outcome": "success"
            }
          ]
        },
        {
          "id": "cen_aher_bolt",
          "text": "岑婆没有立刻原谅阿禾，却把一颗旧螺栓交给他：『明天开始，你学的第一件事是求助。』",
          "requires_any": [
            {
              "beat_id": "light_success"
            },
            {
              "beat_id": "bell_success"
            }
          ]
        }
      ]
    },
    {
      "id": "a_he",
      "name": "阿禾",
      "scene_id": "repair_shed",
      "type": "neutral",
      "occupation": "修灯学徒",
      "description": "年轻的修灯学徒，手指上有新的擦伤。他发现镜框裂开擅自拆下加固，又怕承认弄断了一颗螺栓，把维修记录藏了起来。",
      "dialogue": "我……没什么可说的。灯的事，我自己会处理。",
      "personality": "倔强而心虚，相信只要在师父发现前修好就不算犯错；沉默不是恶意。",
      "knowledge": [
        {
          "id": "ahe_confess_chart",
          "text": "阿禾低声承认了镜框和螺栓的事，把藏在袖中的校准图递给你：『照这个调，灯光能扫到小码头。』",
          "requires": [
            {
              "beat_id": "persuade_ahe",
              "outcome": "success"
            }
          ]
        },
        {
          "id": "ahe_after_record",
          "text": "阿禾得知维修记录已被找到，肩膀垮了下来：『我不是想害送油人……我只是怕。』",
          "requires": [
            {
              "beat_id": "investigate_box",
              "outcome": "success"
            }
          ]
        }
      ]
    }
  ],
  "items": [
    {
      "id": "ferry_medal",
      "name": "渡口纪念章",
      "type": "misc",
      "description": "岑婆交出的旧铜纪念章，正面刻着一盏渡灯，背面是暮潮港的潮纹。"
    }
  ],
